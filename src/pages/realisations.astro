---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Villas de Luxe — Cotonou',
    category: 'batiment',
    label: 'Bâtiment',
    badge: 'orange',
    span: 'large',
    image: '/images/real-villa-cotonou.jpg',
  },
  {
    title: 'Siège Social Moderne',
    category: 'aluminium',
    label: 'Aluminium',
    badge: 'grey',
    span: 'small',
    image: '/images/siege-social-moderne.jpg',
  },
  {
    title: 'Aménagement Place Publique',
    category: 'pavage',
    label: 'Pavage',
    badge: 'grey',
    span: 'medium',
    image: '/images/amenagement-place-publique.jpg',
  },
  {
    title: 'Centre Logistique Régional',
    category: 'batiment',
    label: 'Bâtiment',
    badge: 'grey',
    span: 'medium',
    image: '/images/centre-logistique-regional.jpg',
  },
];
---

<BaseLayout title="Nos réalisations | NPS Group" description="Explorez une sélection de réalisations menées par NPS Group en construction, pavage et menuiserie aluminium.">

  <div class="container real-page">

    <!-- Header -->
    <header class="real-header">
      <p class="eyebrow">PORTFOLIO</p>
      <h1>L'Excellence en <em>Action.</em></h1>
      <p class="real-lead">Découvrez notre galerie de projets, illustrant notre expertise en construction, aménagement urbain et solutions architecturales innovantes.</p>
    </header>

    <!-- Filtres -->
    <div class="real-filters" role="group" aria-label="Filtrer par catégorie">
      <button class="real-filter active" data-filter="all">Tous</button>
      <button class="real-filter" data-filter="batiment">Bâtiment</button>
      <button class="real-filter" data-filter="pavage">Pavage</button>
      <button class="real-filter" data-filter="aluminium">Aluminium</button>
    </div>

    <!-- Grille bento -->
    <div class="real-bento" id="real-grid">
      {projects.map((p) => (
        <article
          class={`real-card real-card--${p.span}`}
          data-category={p.category}
        >
          <img src={p.image} alt={`Réalisation NPS Group : ${p.title}`} loading="lazy" decoding="async" />
          <div class="real-overlay">
            <span class={`real-badge real-badge--${p.badge}`}>{p.label}</span>
            <h2>{p.title}</h2>
          </div>
        </article>
      ))}
    </div>

  </div>

</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.real-filter');
  const cards   = document.querySelectorAll<HTMLElement>('.real-card');
  const grid    = document.getElementById('real-grid')!;

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const cat = btn.dataset.filter!;

      if (cat === 'all') {
        grid.classList.remove('filtered');
        cards.forEach(c => (c.style.display = ''));
      } else {
        grid.classList.add('filtered');
        cards.forEach(c => {
          c.style.display = c.dataset.category === cat ? '' : 'none';
        });
      }
    });
  });
</script>

<style>
  /* ── Page ── */
  .real-page { padding: 80px 0 110px; }

  /* ── Header ── */
  .real-header { max-width: 680px; margin-bottom: 40px; }
  .real-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -.05em;
    line-height: 1.05;
    margin: 12px 0 18px;
    color: var(--ink);
  }
  .real-header em { color: var(--orange); font-style: normal; }
  .real-lead { color: var(--steel); font-size: 1rem; line-height: 1.68; margin: 0; }

  /* ── Filtres ── */
  .real-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }
  .real-filter {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border-radius: 999px;
    font: 800 .65rem Montserrat;
    letter-spacing: .1em;
    text-transform: uppercase;
    cursor: pointer;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    transition: background .18s ease, color .18s ease, border-color .18s ease;
  }
  .real-filter:hover { background: var(--ink); color: #fff; }
  .real-filter.active {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }

  /* ── Bento grid ── */
  .real-bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }
  .real-card--large  { grid-column: span 8; min-height: 420px; }
  .real-card--small  { grid-column: span 4; min-height: 420px; }
  .real-card--medium { grid-column: span 6; min-height: 360px; }

  /* Filtered : grille 2 colonnes uniformes */
  .real-bento.filtered { grid-template-columns: 1fr 1fr; }
  .real-bento.filtered .real-card--large,
  .real-bento.filtered .real-card--small,
  .real-bento.filtered .real-card--medium {
    grid-column: span 1;
    min-height: 360px;
  }

  /* ── Carte ── */
  .real-card {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    display: block;
  }
  .real-card > img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .6s ease;
  }
  .real-card:hover > img { transform: scale(1.05); }

  /* ── Overlay ── */
  .real-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(19,29,33,.88) 0%, rgba(19,29,33,.12) 55%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px 32px;
  }
  .real-overlay h2 {
    color: #f1fbff;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -.03em;
    line-height: 1.15;
    margin: 8px 0 0;
  }
  .real-card--small .real-overlay h2 { font-size: 1.15rem; }

  /* ── Badge catégorie ── */
  .real-badge {
    display: inline-flex;
    padding: 4px 14px;
    border-radius: 999px;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    width: fit-content;
    color: #fff;
  }
  .real-badge--orange { background: var(--orange); }
  .real-badge--grey   { background: var(--steel); }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .real-bento,
    .real-bento.filtered { grid-template-columns: 1fr; }
    .real-card--large,
    .real-card--small,
    .real-card--medium { grid-column: span 1; min-height: 280px; }
  }
</style>
